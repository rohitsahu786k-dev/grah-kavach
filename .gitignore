# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local content backups (Phase 1 audit)
backups/

# Editor / MCP configuration.
# .cursor/mcp.json holds live API tokens (Hostinger, WordPress MCP, 21st.dev),
# so the whole directory stays out of version control.
.cursor/

# The example env file is a template with empty values and is safe to commit,
# unlike the .env* rule above which would otherwise exclude it.
!.env.example
